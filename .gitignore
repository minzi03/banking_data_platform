# =============================================================================
# Banking Data Platform — .gitignore
# =============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.env.local
*.env.production

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/

# ── Spark / Jupyter ───────────────────────────────────────────────────────────
*.log
derby.log
metastore_db/
spark-warehouse/
notebooks/.ipynb_checkpoints/

# ── Docker ────────────────────────────────────────────────────────────────────
docker/volumes/
docker/*.log

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Data (local dev only — never commit actual data) ──────────────────────────
data/raw/
data/processed/
data/generator/output/
*.csv
*.parquet
*.avro

# ── Airflow ───────────────────────────────────────────────────────────────────
airflow/logs/
airflow/plugins/__pycache__/

# ── dbt ───────────────────────────────────────────────────────────────────────
dbt/logs/
dbt/target/
dbt/dbt_packages/
dbt/dbt_modules/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Personal (interview prep, session logs) ──────────────────────────────────
docs/interview/
docs/session-report-*.md

# ── Evidence run artifacts ────────────────────────────────────────────────────
# Output của scripts/generate_metrics_manifest.py cho từng lần chạy. Bằng chứng
# đã được chốt nằm trong docs/evidence/metrics-manifest.yaml (kèm build.git_commit
# và kết quả invariant); các file dưới đây tái tạo được nên không commit.
docs/evidence/generated/
