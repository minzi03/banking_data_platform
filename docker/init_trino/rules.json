      "user": "analytics_report",
      "catalog": "iceberg",
      "schema": "silver",
      "table": "dim_customer",
      "privileges": [
        "SELECT"
      ],
      "columns": [
        {
          "name": "address",
          "mask": "CAST('[REDACTED]' AS VARCHAR)"
        },
        {
          "name": "cccd",
          "mask": "concat('***********', substr(cccd, -4))"
        },
        {
          "name": "date_of_birth",
          "mask": "date_trunc('year', date_of_birth)"
        },
        {
          "name": "email",
          "mask": "concat(substr(email, 1, 1), '*****', '@', split_part(email, '@', 2))"
        },
        {
          "name": "full_name",
          "mask": "concat(substr(full_name, 1, 1), '**')"
        },
        {
          "name": "phone",
          "mask": "concat(substr(phone, 1, 3), '****', substr(phone, 8))"
        }
      ]
    },
