# =============================================================================
# Custom Airflow Image — Banking Data Platform
# Based on apache/airflow:2.10.0
#
# Airflow KHÔNG chạy Spark hay dbt tại chỗ: mọi job được gửi bằng
# `docker exec` vào banking-spark-worker-1 / banking-dbt (xem
# tests/governance/test_airflow_dag_contracts.py). Vì vậy image cần docker CLI
# (socket được mount từ host trong docker-compose.yml), không cần Java, pyspark
# hay provider Spark — không DAG nào còn dùng SparkSubmitOperator.
# =============================================================================
FROM docker:27.3-cli AS docker-cli

FROM apache/airflow:2.10.0-python3.11

USER root

# git is required by scripts/generate_metrics_manifest.py to stamp git_commit /
# git_branch / git_dirty into the evidence manifest. Without it the verifier
# fails the blocking `worktree_clean` invariant, so it is a build dependency,
# not a convenience. procps: pgrep/pkill trong các lệnh kiểm tra.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        procps \
        curl \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# docker CLI cho `/usr/bin/docker exec …` trong DAG. Image gốc không có binary này.
COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker

USER airflow

RUN pip install --no-cache-dir requests
