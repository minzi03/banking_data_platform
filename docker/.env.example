# =============================================================================
# Banking Data Platform — Environment Variables
# Copy file này thành .env và chạy: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Single DB — all source schemas + Airflow backend + ETL ops)
# -----------------------------------------------------------------------------
POSTGRES_USER=banking_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow DB (separate database on same PostgreSQL instance)
AIRFLOW_DB=airflow

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=lakehouse

# -----------------------------------------------------------------------------
# Iceberg REST Catalog
# -----------------------------------------------------------------------------
ICEBERG_REST_HOST=iceberg-rest
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3a://lakehouse/lakehouse
ICEBERG_DB=iceberg_catalog

# -----------------------------------------------------------------------------
# Spark (Standalone cluster — 1 Master + 1 Worker)
# Worker memory: 8192m (configurable)
# Worker cores: 8
# -----------------------------------------------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=9090
SPARK_WORKER_MEMORY=8192m
SPARK_WORKER_CORES=8

# -----------------------------------------------------------------------------
# Kafka + Zookeeper (CDC Layer)
# -----------------------------------------------------------------------------
KAFKA_BROKER=kafka:9092
ZOOKEEPER_HOST=zookeeper:2181
DEBEZIUM_HOST=debezium:8083

# CDC PostgreSQL credentials (used by Debezium connectors)
CDC_DB_USER=cdc_user
CDC_DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Trino (Query engine)
# -----------------------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8085

# -----------------------------------------------------------------------------
# Airflow
# FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_KEY: random string >= 16 chars
# -----------------------------------------------------------------------------
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_SECRET_KEY=CHANGE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_EMAIL=admin@banking.local

# -----------------------------------------------------------------------------
# PII Hash Salt (for masking sensitive data)
# -----------------------------------------------------------------------------
PII_HASH_SALT=CHANGE_ME

# -----------------------------------------------------------------------------
# OpenMetadata (Data Catalog & Lineage)
# -----------------------------------------------------------------------------
OM_DB_USER=openmetadata
OM_DB_PASSWORD=CHANGE_ME
OM_DB_NAME=openmetadata_db
OM_MYSQL_ROOT_PASSWORD=CHANGE_ME
OM_HOST=openmetadata
OM_PORT=8585
